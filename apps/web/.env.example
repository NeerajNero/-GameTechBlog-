# Public site URL (production). See docs/deployment/env-vars.md.
NEXT_PUBLIC_SITE_URL=https://gametechguides.com

# Google AdSense (optional). Leave empty until a publisher ID exists.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Admin publishing (/admin/new). Server-only: never prefix these with NEXT_PUBLIC_.
# Shared secret sent as "Authorization: Bearer <ADMIN_SECRET>" by the admin page.
ADMIN_SECRET=
# GitHub token with "Contents: read and write" on the repo below (fine-grained PAT).
GITHUB_TOKEN=
# Repository that holds the site, as owner/name.
GITHUB_REPO=NeerajNero/-GameTechBlog-
# Branch new articles are committed to (Vercel rebuilds on push).
GITHUB_BRANCH=main
# Author name written into frontmatter. Defaults to the site author when empty.
ADMIN_AUTHOR_NAME=
